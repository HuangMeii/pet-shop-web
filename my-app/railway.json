{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build",
    "installCommand": "npm install"
  },
  "deploy": {
    "startCommand": "npx serve dist -s -l $PORT",
    "numReplicas": 1,
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
